{
  "fields": [
    {
      "response_code": {
        "required": true,
        "elements": {
          "between": [
            100,
            900
          ],
          "type": "integer"
        },
        "len_min": 1,
        "default": [
          200,
          301,
          404
        ],
        "type": "array"
      }
    },
    {
      "request_method": {
        "elements": {
          "one_of": [
            "HEAD",
            "GET",
            "POST",
            "PATCH",
            "PUT"
          ],
          "type": "string"
        },
        "required": true,
        "default": [
          "GET",
          "HEAD"
        ],
        "type": "array"
      }
    },
    {
      "content_type": {
        "elements": {
          "type": "string"
        },
        "required": true,
        "default": [
          "text/plain",
          "application/json"
        ],
        "type": "array"
      }
    },
    {
      "cache_ttl": {
        "gt": 0,
        "default": 300,
        "type": "integer"
      }
    },
    {
      "strategy": {
        "one_of": [
          "memory"
        ],
        "required": true,
        "type": "string"
      }
    },
    {
      "cache_control": {
        "required": true,
        "default": false,
        "type": "boolean"
      }
    },
    {
      "storage_ttl": {
        "type": "integer"
      }
    },
    {
      "memory": {
        "fields": [
          {
            "dictionary_name": {
              "type": "string",
              "default": "kong_db_cache",
              "required": true
            }
          }
        ],
        "required": true,
        "type": "record"
      }
    },
    {
      "vary_query_params": {
        "elements": {
          "type": "string"
        },
        "type": "array"
      }
    },
    {
      "vary_headers": {
        "elements": {
          "type": "string"
        },
        "type": "array"
      }
    }
  ]
}
