{
  "fields": [
    {
      "ldap_host": {
        "type": "string",
        "required": true
      }
    },
    {
      "ldap_port": {
        "between": [
          0,
          65535
        ],
        "type": "integer",
        "required": true
      }
    },
    {
      "ldaps": {
        "required": true,
        "default": false,
        "type": "boolean"
      }
    },
    {
      "start_tls": {
        "type": "boolean",
        "default": false,
        "required": true
      }
    },
    {
      "verify_ldap_host": {
        "type": "boolean",
        "default": false,
        "required": true
      }
    },
    {
      "base_dn": {
        "required": true,
        "type": "string"
      }
    },
    {
      "attribute": {
        "required": true,
        "type": "string"
      }
    },
    {
      "cache_ttl": {
        "type": "number",
        "default": 60,
        "required": true
      }
    },
    {
      "hide_credentials": {
        "default": false,
        "type": "boolean"
      }
    },
    {
      "timeout": {
        "default": 10000,
        "type": "number"
      }
    },
    {
      "keepalive": {
        "default": 60000,
        "type": "number"
      }
    },
    {
      "anonymous": {
        "legacy": true,
        "uuid": true,
        "type": "string"
      }
    },
    {
      "header_type": {
        "default": "ldap",
        "type": "string"
      }
    }
  ]
}
