{
  "fields": [
    {
      "header_name": {
        "default": "x-kong-limit",
        "type": "string"
      }
    },
    {
      "limit_by": {
        "one_of": [
          "consumer",
          "credential",
          "ip"
        ],
        "default": "consumer",
        "type": "string"
      }
    },
    {
      "policy": {
        "one_of": [
          "local",
          "cluster",
          "redis"
        ],
        "default": "cluster",
        "type": "string"
      }
    },
    {
      "fault_tolerant": {
        "default": true,
        "type": "boolean"
      }
    },
    {
      "redis_host": {
        "type": "string"
      }
    },
    {
      "redis_port": {
        "between": [
          0,
          65535
        ],
        "default": 6379,
        "type": "integer"
      }
    },
    {
      "redis_password": {
        "len_min": 0,
        "type": "string"
      }
    },
    {
      "redis_timeout": {
        "default": 2000,
        "type": "number"
      }
    },
    {
      "redis_database": {
        "default": 0,
        "type": "number"
      }
    },
    {
      "block_on_first_violation": {
        "default": false,
        "type": "boolean"
      }
    },
    {
      "hide_client_headers": {
        "default": false,
        "type": "boolean"
      }
    },
    {
      "limits": {
        "required": true,
        "len_min": 1,
        "keys": {
          "type": "string"
        },
        "values": {
          "type": "record",
          "fields": [
            {
              "second": {
                "gt": 0,
                "type": "number"
              }
            },
            {
              "minute": {
                "gt": 0,
                "type": "number"
              }
            },
            {
              "hour": {
                "gt": 0,
                "type": "number"
              }
            },
            {
              "day": {
                "gt": 0,
                "type": "number"
              }
            },
            {
              "month": {
                "gt": 0,
                "type": "number"
              }
            },
            {
              "year": {
                "gt": 0,
                "type": "number"
              }
            }
          ],
          "entity_checks": [
            {
              "at_least_one_of": [
                "second",
                "minute",
                "hour",
                "day",
                "month",
                "year"
              ]
            }
          ],
          "required": true
        },
        "type": "map"
      }
    }
  ]
}
