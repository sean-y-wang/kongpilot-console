{
  "fields": [
    {
      "http_endpoint": {
        "type": "string",
        "required": true
      }
    },
    {
      "method": {
        "one_of": [
          "POST",
          "PUT",
          "PATCH"
        ],
        "default": "POST",
        "type": "string"
      }
    },
    {
      "content_type": {
        "one_of": [
          "application/json"
        ],
        "default": "application/json",
        "type": "string"
      }
    },
    {
      "timeout": {
        "default": 10000,
        "type": "number"
      }
    },
    {
      "keepalive": {
        "default": 60000,
        "type": "number"
      }
    },
    {
      "retry_count": {
        "default": 10,
        "type": "integer"
      }
    },
    {
      "queue_size": {
        "default": 1,
        "type": "integer"
      }
    },
    {
      "flush_timeout": {
        "default": 2,
        "type": "number"
      }
    }
  ]
}
