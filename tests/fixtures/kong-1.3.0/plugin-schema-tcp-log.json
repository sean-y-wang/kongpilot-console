{
  "fields": [
    {
      "host": {
        "type": "string",
        "required": true
      }
    },
    {
      "port": {
        "between": [
          0,
          65535
        ],
        "type": "integer",
        "required": true
      }
    },
    {
      "timeout": {
        "default": 10000,
        "type": "number"
      }
    },
    {
      "keepalive": {
        "default": 60000,
        "type": "number"
      }
    },
    {
      "tls": {
        "default": false,
        "type": "boolean"
      }
    },
    {
      "tls_sni": {
        "type": "string"
      }
    }
  ]
}
