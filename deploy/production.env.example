# Copy to deploy/private/<project>/.env (0600); generate every secret separately.
# Values in angle brackets are required placeholders, never usable defaults.
COMPOSE_PROJECT_NAME=kongpilot-production
KONGOS_API_IMAGE=kongpilot/console-api:<release>
KONGOS_WEB_IMAGE=kongpilot/console-web:<release>
KONGOS_PORTAL_IMAGE=kongpilot/portal-web:<release>
KONGOS_COLLECTOR_IMAGE=kongpilot/telemetry-collector:<release>
KONG_DATABASE_PASSWORD=<generate-url-safe-password>
CONSOLE_DATABASE_PASSWORD=<generate-url-safe-password>
CONSOLE_APP_PASSWORD=<generate-url-safe-password>
REDIS_PASSWORD=<generate-url-safe-password>
# Redis: standalone (bundled) by default. For an external Redis Cluster see docs/reference/redis.md:
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=redis.example.internal:6379
# REDIS_TLS=false
# REDIS_KEY_PREFIX=kongpilot-prod:
CONSOLE_ENCRYPTION_KEY=<generate-32-random-bytes-as-64-hex>
APP_SECRET=<generate-independent-random-secret>
PORTAL_SECRET=<generate-independent-random-secret>
BOOTSTRAP_ADMIN_USERNAME=platform-admin
BOOTSTRAP_ADMIN_PASSWORD=<generate-unique-strong-password>
COOKIE_SECURE=true
PUBLIC_ORIGINS=https://console.example.com:18443
PORTAL_PUBLIC_ORIGINS=https://portal.example.com:19443
KONGOS_HTTPS_BIND_IP=127.0.0.1
CONSOLE_HTTPS_PORT=18443
PORTAL_HTTPS_PORT=19443
KONG_PROXY_PORT=18000
KONGOS_CONSOLE_TLS_DIRECTORY=./deploy/private/kongpilot-production/tls/console
KONGOS_PORTAL_TLS_DIRECTORY=./deploy/private/kongpilot-production/tls/portal
KONGOS_METRICS_DIRECTORY=./deploy/private/kongpilot-production/metrics
KONGOS_CONSOLE_HOSTNAME=console.example.com
KONGOS_DECK_CA_DIRECTORY=./deploy/private/kongpilot-production/trust
OUTBOUND_ALLOWED_HOSTS=kong,prometheus,loki
# M11 schedule workers: default off. Site must opt in only after natural-timer acceptance.
ENTITY_SCHEDULES_ENABLED=false
BUSINESS_SCHEDULES_ENABLED=false
EVENT_DELIVERY_ALLOWED_HOSTS=
AUTH_PROVIDERS_JSON=[]
AUTH_PROVIDER_ALLOWED_HOSTS=
# Check Docker/host conflicts; update subnet and all of its IPs together.
KONG_ADMIN_SUBNET=172.30.11.0/24
CONSOLE_KONG_ADMIN_IP=172.30.11.10
KONG_ADMIN_IP=172.30.11.20
KONG_STORAGE_SUBNET=172.30.21.0/24
KONG_STORAGE_IP=172.30.21.10
KONG_DB_IP=172.30.21.20
TELEMETRY_SUBNET=172.30.31.0/24
CONSOLE_TELEMETRY_IP=172.30.31.10
PROMETHEUS_TELEMETRY_IP=172.30.31.20
COLLECTOR_TELEMETRY_IP=172.30.31.30
PORTAL_EDGE_SUBNET=172.30.41.0/24
CONSOLE_PORTAL_IP=172.30.41.10
PORTAL_WEB_IP=172.30.41.20
PORTAL_ENTRY_SUBNET=172.30.42.0/24
PORTAL_ENTRY_IP=172.30.42.20
PROXY_EDGE_SUBNET=172.30.51.0/24
COLLECTOR_PROXY_IP=172.30.51.30
OBSERVABILITY_SUBNET=172.30.52.0/24
COLLECTOR_OBSERVABILITY_IP=172.30.52.30
COLLECTOR_LOKI_ENABLED=true
LOG_LEVEL=info
