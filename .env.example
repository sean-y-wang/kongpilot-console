# Copy to .env and replace every REPLACE_* value before the first start.
# These are placeholders, not usable credentials. .env is excluded from images/git.
KONG_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_KONG_DB_PASSWORD
CONSOLE_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_CONSOLE_DB_PASSWORD
CONSOLE_APP_PASSWORD=REPLACE_WITH_RANDOM_NON_SUPERUSER_APP_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
BOOTSTRAP_ADMIN_USERNAME=admin
# 12–72 UTF-8 bytes, with uppercase/lowercase/digit/symbol. Generator guarantees them.
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_POLICY_COMPLIANT_RANDOM_PASSWORD
# Generate with: openssl rand -hex 32
CONSOLE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Generate independently with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Independent 32-byte secret, API only; never reuse APP_SECRET.
PORTAL_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
PORTAL_PUBLIC_ORIGINS=http://127.0.0.1:8082,http://localhost:8082
PORTAL_WEB_PORT=8082
PORTAL_EDGE_SUBNET=172.28.41.0/24
CONSOLE_PORTAL_IP=172.28.41.10
PORTAL_WEB_IP=172.28.41.20
PORTAL_ENTRY_SUBNET=172.28.42.0/24
PORTAL_ENTRY_IP=172.28.42.20
CONSOLE_WEB_PORT=8080
KONG_PROXY_PORT=8000
# Exact management sources; override subnet + both addresses together if they conflict.
KONG_ADMIN_SUBNET=172.28.11.0/24
KONG_ADMIN_IP=172.28.11.20
CONSOLE_KONG_ADMIN_IP=172.28.11.10
# Fixed isolated Kong storage; BFF protects the exact DB IP without joining this net.
KONG_STORAGE_SUBNET=172.28.21.0/24
KONG_STORAGE_IP=172.28.21.10
KONG_DB_IP=172.28.21.20
# Optional secondary profile uses172.28.12/24 Admin and172.28.22/24 storage by default.
# Customize both Kong/BFF Admin addresses, storage addresses and subnets as a group.
PROTECTED_DESTINATION_HOSTS=
# M11 entity schedule worker is opt-in. Enable only with genuine timed acceptance
# covering current authority, approved intent, lease/window and native outcome.
# 默认关闭；开启后须完成真实定时执行验收，配置为 true 不代表已验收。
ENTITY_SCHEDULES_ENABLED=false
BUSINESS_SCHEDULES_ENABLED=false
EVENT_DELIVERY_ALLOWED_HOSTS=
EVENT_SMTP_HOST=
EVENT_SMTP_PORT=587
EVENT_SMTP_MODE=starttls
EVENT_SMTP_SERVERNAME=
EVENT_SMTP_FROM=
EVENT_SMTP_USERNAME=
# Credential and CA paths must be mounted read-only into console-api.
EVENT_SMTP_PASSWORD_FILE=
EVENT_SMTP_CA_FILE=
EVENT_DELIVERY_HTTPS_CA_FILE=
# Optional M5 internal telemetry overlay; none of these are credentials.
TELEMETRY_SUBNET=172.28.31.0/24
CONSOLE_TELEMETRY_IP=172.28.31.10
PROMETHEUS_TELEMETRY_IP=172.28.31.20
COLLECTOR_TELEMETRY_IP=172.28.31.30
# Fixed collector interfaces: customize each subnet/address together.
# The overlay derives COLLECTOR_SELF_IPS/protected addresses from these three IPs.
PROXY_EDGE_SUBNET=172.21.0.0/16
COLLECTOR_PROXY_IP=172.21.0.5
OBSERVABILITY_SUBNET=172.22.0.0/16
COLLECTOR_OBSERVABILITY_IP=172.22.0.5
COLLECTOR_LOKI_ENABLED=true
# Optional dedicated collector bearer file inside its read-only secret directory.
COLLECTOR_LOKI_AUTH_FILE=
# Controlled collector push authority; currently only this private endpoint is allowed.
COLLECTOR_LOKI_URL=http://loki:3100
# Set true behind production TLS; local HTTP demo requires false.
COOKIE_SECURE=false
# Exact host allowlist protects connection-test endpoints against SSRF.
OUTBOUND_ALLOWED_HOSTS=kong,prometheus,loki,mock-kong,localhost,127.0.0.1
# Optional identity providers: configure server secrets only in the private .env.
AUTH_PROVIDERS_JSON=[]
AUTH_PROVIDER_ALLOWED_HOSTS=
# Comma-separated exact HTTPS origins when enabling production SSO callbacks.
PUBLIC_ORIGINS=
PASSWORD_BCRYPT_ROUNDS=12
# Optional logging destination kept under the console, not Kong's database.
LOG_LEVEL=info
